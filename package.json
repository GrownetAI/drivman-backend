{
  "name": "drivman-backend",
  "version": "0.1.0",
  "description": "DRIVMAN — Backend API (Phase 4, not yet started). Folder structure and dependencies are pre-set so setup is ready the moment Phase 4 begins.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "dev:mail": "node scripts/devMailSink.js & trap 'kill 0' EXIT INT TERM; EMAIL_PROVIDER=smtp SMTP_HOST=127.0.0.1 SMTP_PORT=2525 SMTP_USER=dev SMTP_PASS=dev nodemon server.js",
    "mail:sink": "node scripts/devMailSink.js",
    "start": "node server.js",
    "test": "node --test tests/",
    "seed": "node src/seed/seed.js",
    "seed:fresh": "node src/seed/seed.js --fresh --admin"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "mongoose-lean-virtuals": "^2.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "razorpay": "^2.9.4",
    "resend": "^6.18.1",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
