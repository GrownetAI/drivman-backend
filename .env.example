# DRIVMAN Backend — Environment Variables
# Copy this file to ".env" when Phase 4 (backend development) begins.
# Never commit the real ".env" file — it is already covered by .gitignore.

PORT=5000
NODE_ENV=development
MONGO_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Cloudinary (product image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Frontend URL (for CORS + email links)
CLIENT_URL=
