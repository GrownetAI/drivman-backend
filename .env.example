# DRIVMAN Backend — Environment Variables
# Copy this file to ".env" and fill in the values.
# Never commit the real ".env" — it is already covered by .gitignore.

PORT=5000
NODE_ENV=development
MONGO_URI=

# --- Auth --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access-token lifetime. Keep it short — refresh tokens handle longevity.
JWT_EXPIRES_IN=15m
# Refresh-token lifetime, in DAYS (integer).
JWT_REFRESH_EXPIRES_IN_DAYS=7

# --- Email --------------------------------------------------------------------
# Required — the server refuses to boot without it, because signup sends a
# verification code by email.
#
# EMAIL_PROVIDER selects the adapter: "resend" (default) or "smtp".
EMAIL_PROVIDER=resend

# Resend — https://resend.com/api-keys. The sending domain must be verified
# under Domains first, or Resend rejects anything but your own account address.
RESEND_API_KEY=

# The From header. Must be on a domain verified with the provider, and differs
# per environment, so it is never hardcoded.
MAIL_FROM="DRIVMAN <no-reply@yourdomain.com>"
# Optional — where replies go if that differs from the sender.
MAIL_REPLY_TO=

# SMTP fallback, used only when EMAIL_PROVIDER=smtp.
# Gmail:    SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com,
#           SMTP_PASS=<App Password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Email OTP ------------------------------------------------------------------
# Optional. Codes are stored as a keyed HMAC so a database dump can't be
# brute-forced through the 10^6 possibilities. Falls back to JWT_SECRET when
# unset; set it separately to rotate one without invalidating the other.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=

# --- Logging --------------------------------------------------------------------
# debug | info | warn | error | silent. Defaults to debug outside production.
LOG_LEVEL=

# --- OTP / SMS (Twilio Verify) -----------------------------------------------
# Optional. When these are blank and NODE_ENV is not "production", the server
# runs in dev-OTP mode: the code is always DEV_OTP_CODE and is printed to the
# console instead of being sent by SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
DEV_OTP_CODE=123456

# --- Payments (Razorpay) ------------------------------------------------------
# Optional. Without these, only Cash-on-Delivery checkout is available.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Cloudinary (product image storage) --------------------------------------
# Required for POST /api/products/images. Without them that endpoint answers
# 400 — the rest of the product API works fine on image URLs supplied directly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Where uploads land, and the per-file size cap in bytes (default 5MB).
CLOUDINARY_FOLDER=drivman/products
MAX_UPLOAD_BYTES=

# --- Catalog ------------------------------------------------------------------
# At or below this (but above zero) a product shows as "low stock" in the admin
# product list and its stock filter. Default 5.
LOW_STOCK_THRESHOLD=5

# --- Storefront ---------------------------------------------------------------
# Used for CORS and for building links inside emails.
# Comma-separate to allow several origins.
CLIENT_URL=http://localhost:3000

# Shipping: orders at or above the threshold ship free.
SHIPPING_FEE=99
FREE_SHIPPING_THRESHOLD=5000

# --- Seed script (npm run seed:fresh -- --admin) ------------------------------
ADMIN_EMAIL=admin@drivman.com
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=+919999999999
